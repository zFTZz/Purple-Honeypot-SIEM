# Copie este arquivo para alerting/.env e preencha.
# Nunca faça commit do .env: ele contém segredos e já está no .gitignore.

# 1) Crie um bot no Telegram: fale com @BotFather e execute /newbot.
# 2) Cole abaixo o token retornado (formato 123456:ABC...).
TELEGRAM_BOT_TOKEN=

# 3) Envie /start para o bot e obtenha o chat_id em:
#    https://api.telegram.org/bot<SEU_TOKEN>/getUpdates
TELEGRAM_CHAT_ID=

# Opcionais
MIN_LEVEL=10
COOLDOWN_SECONDS=120
WAZUH_CONTAINER=wazuh-manager
ALERTS_PATH=/var/ossec/logs/alerts/alerts.json
