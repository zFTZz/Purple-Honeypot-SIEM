# Copie este arquivo para alerting/.env e preencha.
# NUNCA commite o .env (ele contém segredo). O .gitignore já bloqueia.

# 1) Crie um bot no Telegram: fale com @BotFather -> /newbot
# 2) Cole abaixo o token que ele devolver (formato 123456:ABC-...)
TELEGRAM_BOT_TOKEN=

# 3) Mande uma mensagem para o seu bot e descubra o chat_id em:
#    https://api.telegram.org/bot<SEU_TOKEN>/getUpdates
TELEGRAM_CHAT_ID=

# Opcionais
MIN_LEVEL=10
COOLDOWN_SECONDS=120
WAZUH_CONTAINER=wazuh-manager
ALERTS_PATH=/var/ossec/logs/alerts/alerts.json
