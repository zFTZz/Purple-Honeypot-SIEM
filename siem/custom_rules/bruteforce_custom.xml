<!-- Projeto 1: deteccao em cima dos logs JSON do honeypot.
     Campos do log: type, src_ip (+alias srcip p/ same_srcip), user, password, command, timestamp -->
<group name="honeypot,">
  <!-- Falha isolada: nivel baixo, serve de base p/ correlacao -->
  <rule id="100100" level="5">
    <field name="type">ssh.login_failed</field>
    <description>Honeypot SSH: tentativa de login falhou.</description>
  </rule>

  <!-- Brute-force: 5+ falhas do MESMO ip em 120s -->
  <rule id="100101" level="10" frequency="5" timeframe="120">
    <if_matched_sid>100100</if_matched_sid>
    <same_srcip />
    <description>Honeypot SSH: possivel brute-force, 5+ falhas do mesmo IP em 2 minutos.</description>
  </rule>
</group>
